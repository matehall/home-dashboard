MQTT_HOST=192.168.1.8
MQTT_PORT=1883
MQTT_USER=openhabian
MQTT_PASS=openhabian
PORT=3000

# NexBlue Edge 2 (valfritt). Utan NEXBLUE_USERNAME/NEXBLUE_PASSWORD är integrationen avstängd.
# Valfritt: NEXBLUE_API_BASE_URL (standard https://api.nexblue.com/third_party)
# NEXBLUE_MOCK=1 ger testdata som inte sparas i databasen.
NEXBLUE_USERNAME=
NEXBLUE_PASSWORD=
NEXBLUE_POLL_SECONDS=60

# Roborock S5 (valfritt, lokalt miio). Utan ROBOROCK_IP/ROBOROCK_TOKEN är integrationen avstängd.
# Token hämtas med Xiaomi-Cloud-Tokens-Extractor. Ge dammsugaren en fast IP i routern.
# ROBOROCK_MOCK=1 ger testdata som inte sparas i databasen.
ROBOROCK_IP=
ROBOROCK_TOKEN=
ROBOROCK_POLL_SECONDS=30

# Tuya-brytare (valfritt, Tuya Cloud API, skrivskyddat). Utan nycklarna är integrationen avstängd.
# Skapa ett Cloud-projekt på iot.tuya.com, länka Smart Life-appen och hämta Access ID/Secret och UID.
# TUYA_ENDPOINT: openapi.tuyaeu.com (EU, standard), openapi.tuyaus.com, openapi.tuyacn.com, openapi.tuyain.com
# TUYA_MOCK=1 ger testdata som inte sparas i databasen.
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_UID=
TUYA_ENDPOINT=https://openapi.tuyaeu.com
TUYA_POLL_SECONDS=60
